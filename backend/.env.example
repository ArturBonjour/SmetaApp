# =============================================
# СметаАпп — Переменные окружения (пример)
# Скопируйте в .env: cp .env.example .env
# =============================================

# Строка подключения к БД (SQLite)
# Для разработки:
DATABASE_URL="file:./prisma/dev.db"
# Для Docker (volume): DATABASE_URL="file:/app/data/prod.db"

# Секрет для подписи JWT — ОБЯЗАТЕЛЬНО смените в продакшн!
JWT_SECRET="super-secret-jwt-key-change-in-production"

# Порт бэкенда
PORT=3001

# Разрешённый origin для CORS (адрес фронтенда)
# Разработка:
FRONTEND_URL="http://localhost:5173"
# Docker:  FRONTEND_URL="http://localhost"
